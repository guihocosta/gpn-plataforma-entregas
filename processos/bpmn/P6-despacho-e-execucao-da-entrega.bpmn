<bpmn:exclusiveGateway id="PL_G0" name="Há entregador disponível?"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:exclusiveGateway>
