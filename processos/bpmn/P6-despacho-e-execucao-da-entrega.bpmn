<bpmn:userTask id="EN_T1" name="Avaliar oferta"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="EN_B1" name="1 min sem resposta" attachedToRef="EN_T1"><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:timerEventDefinition id="EN_B1_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="EN_E0" name="Oferta expirada"><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="EN_T2" name="Responder à oferta"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="EN_G1" name="Aceitou a corrida?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="EN_E1" name="Corrida recusada"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
<bpmn:receiveTask id="EN_TC" name="Receber confirmação da corrida"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="EN_BC" name="30 s sem confirmação" attachedToRef="EN_TC"><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:timerEventDefinition id="EN_BC_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="EN_EC" name="Corrida não confirmada"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="EN_T4" name="Ir ao restaurante e retirar o pedido"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="EN_B2" name="Prazo de coleta esgotado" attachedToRef="EN_T4"><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:timerEventDefinition id="EN_B2_ed"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">horário previsto de chegada ao restaurante</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="EN_E2" name="Corrida cancelada"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="EN_T5" name="Confirmar coleta"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:sendTask>
<bpmn:subProcess id="SP" name="Entregar o pedido"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing><bpmn:startEvent id="SP_S"><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="EN_T6" name="Levar o pedido ao endereço"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="EN_T7" name="Avisar chegada e aguardar o cliente"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="EN_B4" name="5 min sem o cliente" attachedToRef="EN_T7"><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:timerEventDefinition id="EN_B4_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="EN_GM"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="EN_T10" name="Digitar o código informado pelo cliente"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask><bpmn:sendTask id="EN_T11" name="Concluir a entrega"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="SP_E1" name="Entrega concluída"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent><bpmn:sendTask id="EN_T8" name="Informar cliente não localizado"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="EN_T9" name="Receber orientação do suporte"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:receiveTask><bpmn:exclusiveGateway id="EN_G3" name="Orientação?"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="SP_E2" name="Devolução orientada"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:errorEventDefinition id="SP_E2_ed" /></bpmn:endEvent><bpmn:sequenceFlow id="Flow_12" sourceRef="SP_S" targetRef="EN_T6" /><bpmn:sequenceFlow id="Flow_13" sourceRef="EN_T6" targetRef="EN_T7" /><bpmn:sequenceFlow id="Flow_14" sourceRef="EN_T7" targetRef="EN_GM" /><bpmn:sequenceFlow id="Flow_15" sourceRef="EN_B4" targetRef="EN_T8" /><bpmn:sequenceFlow id="Flow_16" sourceRef="EN_GM" targetRef="EN_T10" /><bpmn:sequenceFlow id="Flow_17" sourceRef="EN_T10" targetRef="EN_T11" /><bpmn:sequenceFlow id="Flow_18" sourceRef="EN_T11" targetRef="SP_E1" /><bpmn:sequenceFlow id="Flow_19" sourceRef="EN_T8" targetRef="EN_T9" /><bpmn:sequenceFlow id="Flow_20" sourceRef="EN_T9" targetRef="EN_G3" /><bpmn:sequenceFlow id="Flow_21" name="entregar" sourceRef="EN_G3" targetRef="EN_GM" /><bpmn:sequenceFlow id="Flow_22" name="devolver" sourceRef="EN_G3" targetRef="SP_E2" /></bpmn:subProcess>
<bpmn:boundaryEvent id="EN_BE" name="Devolução orientada" attachedToRef="SP"><bpmn:outgoing>Flow_23</bpmn:outgoing><bpmn:errorEventDefinition id="EN_BE_ed" /></bpmn:boundaryEvent>
<bpmn:userTask id="EN_T12" name="Devolver o pedido e registrar o código de devolução"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="EN_E6" name="Pedido devolvido"><bpmn:incoming>Flow_24</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="EN_B5" name="Prazo da entrega esgotado" attachedToRef="SP"><bpmn:outgoing>Flow_26</bpmn:outgoing><bpmn:timerEventDefinition id="EN_B5_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">tempo estimado da rota + tolerância</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
