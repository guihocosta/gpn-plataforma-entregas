<bpmn:receiveTask id="PL_T3" name="Receber resposta da oferta"><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="PL_B1" name="1 min sem resposta" attachedToRef="PL_T3"><bpmn:outgoing>Flow_36</bpmn:outgoing><bpmn:timerEventDefinition id="PL_B1_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="PL_G1" name="Aceitou?"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="PL_GR1"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:incoming>Flow_36</bpmn:incoming><bpmn:incoming>Flow_37</bpmn:incoming><bpmn:outgoing>Flow_38</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="PL_TC" name="Confirmar corrida ao entregador"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_39</bpmn:outgoing></bpmn:sendTask>
<bpmn:receiveTask id="PL_T5" name="Receber confirmação de coleta"><bpmn:incoming>Flow_39</bpmn:incoming><bpmn:outgoing>Flow_40</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="PL_B2" name="Prazo de coleta esgotado" attachedToRef="PL_T5"><bpmn:outgoing>Flow_37</bpmn:outgoing><bpmn:timerEventDefinition id="PL_B2_ed"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">horário previsto de chegada ao restaurante</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="PG_T2" name="Avisar cliente: pedido saiu para entrega"><bpmn:incoming>Flow_40</bpmn:incoming><bpmn:outgoing>Flow_41</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="PL_GM2"><bpmn:incoming>Flow_41</bpmn:incoming><bpmn:incoming>Flow_53</bpmn:incoming><bpmn:outgoing>Flow_42</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="PL_GE2"><bpmn:incoming>Flow_42</bpmn:incoming><bpmn:outgoing>Flow_43</bpmn:outgoing><bpmn:outgoing>Flow_44</bpmn:outgoing><bpmn:outgoing>Flow_45</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="PL_TM2" name="Prazo da entrega esgotado"><bpmn:incoming>Flow_44</bpmn:incoming><bpmn:outgoing>Flow_46</bpmn:outgoing><bpmn:timerEventDefinition id="PL_TM2_ed"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">horário da coleta + tempo estimado da rota + tolerância</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="PL_E4" name="Ocorrência aberta (prazo esgotado)"><bpmn:incoming>Flow_46</bpmn:incoming></bpmn:endEvent>
<bpmn:receiveTask id="PL_T7" name="Receber conclusão da entrega"><bpmn:incoming>Flow_45</bpmn:incoming><bpmn:outgoing>Flow_47</bpmn:outgoing></bpmn:receiveTask>
<bpmn:serviceTask id="PG_T3" name="Registrar entrega concluída"><bpmn:incoming>Flow_47</bpmn:incoming><bpmn:outgoing>Flow_48</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="PG_T4" name="Avisar cliente: pedido entregue"><bpmn:incoming>Flow_48</bpmn:incoming><bpmn:outgoing>Flow_49</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="PG_E1" name="Entrega concluída"><bpmn:incoming>Flow_49</bpmn:incoming></bpmn:endEvent>
<bpmn:receiveTask id="PS_T1" name="Receber aviso de cliente não localizado"><bpmn:incoming>Flow_43</bpmn:incoming><bpmn:outgoing>Flow_50</bpmn:outgoing></bpmn:receiveTask>
<bpmn:userTask id="PS_T2" name="Contatar o cliente"><bpmn:incoming>Flow_50</bpmn:incoming><bpmn:outgoing>Flow_51</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="PS_T3" name="Enviar orientação ao entregador"><bpmn:incoming>Flow_51</bpmn:incoming><bpmn:outgoing>Flow_52</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="PS_G1" name="Cliente localizado?"><bpmn:incoming>Flow_52</bpmn:incoming><bpmn:outgoing>Flow_53</bpmn:outgoing><bpmn:outgoing>Flow_54</bpmn:outgoing></bpmn:exclusiveGateway>
