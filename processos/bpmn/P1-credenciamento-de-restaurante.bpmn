<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:collaboration id="Collaboration_P1">
    <bpmn:participant id="P1_Rest" name="Restaurante" processRef="P1_Process_Rest" />
    <bpmn:participant id="P1_Pla" name="Plataforma" processRef="P1_Process_Pla" />
    <bpmn:messageFlow id="P1_Msg_1" name="Pedido de credenciamento" sourceRef="P1R_T2" targetRef="P1P_S" />
    <bpmn:messageFlow id="P1_Msg_2" name="Pendência no credenciamento" sourceRef="P1P_T6" targetRef="P1R_T3" />
    <bpmn:messageFlow id="P1_Msg_3" name="Documentos corrigidos" sourceRef="P1R_T6" targetRef="P1P_T7" />
    <bpmn:messageFlow id="P1_Msg_4" name="Aviso de atraso na análise" sourceRef="P1P_TA" targetRef="P1R_TA" />
    <bpmn:messageFlow id="P1_Msg_5" name="Contrato digital" sourceRef="P1P_T5" targetRef="P1R_TC" />
    <bpmn:messageFlow id="P1_Msg_6" name="Contrato assinado" sourceRef="P1R_T8" targetRef="P1P_T9" />
    <bpmn:messageFlow id="P1_Msg_7" name="Resultado do credenciamento" sourceRef="P1P_T4" targetRef="P1R_T4" />
  </bpmn:collaboration>
  <bpmn:process id="P1_Process_Rest" isExecutable="false">
    <bpmn:startEvent id="P1R_S" name="Decide vender na plataforma">
      <bpmn:outgoing>P1_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1R_T1" name="Preencher solicitação e anexar documentos">
      <bpmn:incoming>P1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P1R_T2" name="Enviar solicitação">
      <bpmn:incoming>P1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P1R_GM">
      <bpmn:incoming>P1_Flow_3</bpmn:incoming>
      <bpmn:incoming>P1_Flow_9</bpmn:incoming>
      <bpmn:incoming>P1_Flow_17</bpmn:incoming>
      <bpmn:incoming>P1_Flow_23</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="P1R_GE">
      <bpmn:incoming>P1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="P1R_TA" name="Receber aviso de atraso na análise">
      <bpmn:incoming>P1_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="P1R_T4" name="Receber resultado do credenciamento">
      <bpmn:incoming>P1_Flow_5</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="P1R_GR" name="Resultado?">
      <bpmn:incoming>P1_Flow_10</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P1R_E1" name="Restaurante ativo">
      <bpmn:incoming>P1_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P1R_E2" name="Solicitação recusada ou arquivada">
      <bpmn:incoming>P1_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="P1R_T3" name="Receber pendência no credenciamento">
      <bpmn:incoming>P1_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="P1R_SPC" name="Corrigir pendência">
      <bpmn:incoming>P1_Flow_13</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_17</bpmn:outgoing>
      <bpmn:startEvent id="P1R_SPC_S">
        <bpmn:outgoing>P1_Flow_14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="P1R_T5" name="Corrigir documentos">
        <bpmn:incoming>P1_Flow_14</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P1R_T6" name="Reenviar documentos">
        <bpmn:incoming>P1_Flow_15</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="P1R_SPC_E">
        <bpmn:incoming>P1_Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P1_Flow_14" sourceRef="P1R_SPC_S" targetRef="P1R_T5" />
      <bpmn:sequenceFlow id="P1_Flow_15" sourceRef="P1R_T5" targetRef="P1R_T6" />
      <bpmn:sequenceFlow id="P1_Flow_16" sourceRef="P1R_T6" targetRef="P1R_SPC_E" />
    </bpmn:subProcess>
    <bpmn:endEvent id="P1R_E3" name="Solicitação arquivada">
      <bpmn:incoming>P1_Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="P1R_TC" name="Receber contrato digital">
      <bpmn:incoming>P1_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_19</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="P1R_SPK" name="Assinar contrato">
      <bpmn:incoming>P1_Flow_19</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_23</bpmn:outgoing>
      <bpmn:startEvent id="P1R_SPK_S">
        <bpmn:outgoing>P1_Flow_20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="P1R_T7" name="Assinar contrato digital">
        <bpmn:incoming>P1_Flow_20</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="P1R_T8" name="Enviar contrato assinado">
        <bpmn:incoming>P1_Flow_21</bpmn:incoming>
        <bpmn:outgoing>P1_Flow_22</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="P1R_SPK_E">
        <bpmn:incoming>P1_Flow_22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P1_Flow_20" sourceRef="P1R_SPK_S" targetRef="P1R_T7" />
      <bpmn:sequenceFlow id="P1_Flow_21" sourceRef="P1R_T7" targetRef="P1R_T8" />
      <bpmn:sequenceFlow id="P1_Flow_22" sourceRef="P1R_T8" targetRef="P1R_SPK_E" />
    </bpmn:subProcess>
    <bpmn:endEvent id="P1R_E4" name="Solicitação arquivada">
      <bpmn:incoming>P1_Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="P1R_BP" name="Prazo da pendência esgotado" attachedToRef="P1R_SPC">
      <bpmn:outgoing>P1_Flow_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P1R_BP_ed">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">data da pendência + 7 dias</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P1R_BK" name="Prazo do contrato esgotado" attachedToRef="P1R_SPK">
      <bpmn:outgoing>P1_Flow_24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P1R_BK_ed">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">data do envio do contrato + 7 dias</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P1_Flow_1" sourceRef="P1R_S" targetRef="P1R_T1" />
    <bpmn:sequenceFlow id="P1_Flow_2" sourceRef="P1R_T1" targetRef="P1R_T2" />
    <bpmn:sequenceFlow id="P1_Flow_3" sourceRef="P1R_T2" targetRef="P1R_GM" />
    <bpmn:sequenceFlow id="P1_Flow_9" sourceRef="P1R_TA" targetRef="P1R_GM" />
    <bpmn:sequenceFlow id="P1_Flow_17" sourceRef="P1R_SPC" targetRef="P1R_GM" />
    <bpmn:sequenceFlow id="P1_Flow_23" sourceRef="P1R_SPK" targetRef="P1R_GM" />
    <bpmn:sequenceFlow id="P1_Flow_4" sourceRef="P1R_GM" targetRef="P1R_GE" />
    <bpmn:sequenceFlow id="P1_Flow_5" sourceRef="P1R_GE" targetRef="P1R_T4" />
    <bpmn:sequenceFlow id="P1_Flow_6" sourceRef="P1R_GE" targetRef="P1R_TA" />
    <bpmn:sequenceFlow id="P1_Flow_7" sourceRef="P1R_GE" targetRef="P1R_T3" />
    <bpmn:sequenceFlow id="P1_Flow_8" sourceRef="P1R_GE" targetRef="P1R_TC" />
    <bpmn:sequenceFlow id="P1_Flow_10" sourceRef="P1R_T4" targetRef="P1R_GR" />
    <bpmn:sequenceFlow id="P1_Flow_11" name="ativo" sourceRef="P1R_GR" targetRef="P1R_E1" />
    <bpmn:sequenceFlow id="P1_Flow_12" name="recusado ou arquivado" sourceRef="P1R_GR" targetRef="P1R_E2" />
    <bpmn:sequenceFlow id="P1_Flow_13" sourceRef="P1R_T3" targetRef="P1R_SPC" />
    <bpmn:sequenceFlow id="P1_Flow_18" sourceRef="P1R_BP" targetRef="P1R_E3" />
    <bpmn:sequenceFlow id="P1_Flow_19" sourceRef="P1R_TC" targetRef="P1R_SPK" />
    <bpmn:sequenceFlow id="P1_Flow_24" sourceRef="P1R_BK" targetRef="P1R_E4" />
  </bpmn:process>
  <bpmn:process id="P1_Process_Pla" isExecutable="false">
    <bpmn:laneSet id="P1_Process_Pla_ls">
      <bpmn:lane id="P1_L_Ana" name="Analista de cadastro">
        <bpmn:flowNodeRef>P1P_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_TR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_BA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_L_Sis" name="Sistema de cadastro">
        <bpmn:flowNodeRef>P1P_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_TM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_TK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_GR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_TA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1P_EA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1P_S" name="Solicitação recebida">
      <bpmn:outgoing>P1_Flow_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P1P_S_ed" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P1P_T0" name="Registrar solicitação e gerar protocolo">
      <bpmn:incoming>P1_Flow_25</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1P_GM">
      <bpmn:incoming>P1_Flow_26</bpmn:incoming>
      <bpmn:incoming>P1_Flow_39</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P1P_T1" name="Conferir documentos e dados">
      <bpmn:incoming>P1_Flow_27</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1P_G1" name="Completo e válido?">
      <bpmn:incoming>P1_Flow_28</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_29</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P1P_GP">
      <bpmn:incoming>P1_Flow_30</bpmn:incoming>
      <bpmn:incoming>P1_Flow_33</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P1P_T6" name="Notificar pendência ao restaurante">
      <bpmn:incoming>P1_Flow_35</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P1P_GE">
      <bpmn:incoming>P1_Flow_36</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_37</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_38</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="P1P_T7" name="Receber documentos corrigidos">
      <bpmn:incoming>P1_Flow_37</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_39</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="P1P_TM" name="Prazo da pendência esgotado">
      <bpmn:incoming>P1_Flow_38</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_40</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P1P_TM_ed">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">data da pendência + 7 dias</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P1P_GA">
      <bpmn:incoming>P1_Flow_40</bpmn:incoming>
      <bpmn:incoming>P1_Flow_46</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P1P_T8" name="Arquivar solicitação">
      <bpmn:incoming>P1_Flow_41</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P1P_T5" name="Enviar contrato digital">
      <bpmn:incoming>P1_Flow_32</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_43</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="P1P_GC">
      <bpmn:incoming>P1_Flow_43</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_44</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_45</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="P1P_T9" name="Receber contrato assinado">
      <bpmn:incoming>P1_Flow_44</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_47</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="P1P_TK" name="Prazo do contrato esgotado">
      <bpmn:incoming>P1_Flow_45</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_46</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P1P_TK_ed">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">data do envio do contrato + 7 dias</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P1P_T3" name="Ativar restaurante">
      <bpmn:incoming>P1_Flow_47</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1P_GR">
      <bpmn:incoming>P1_Flow_42</bpmn:incoming>
      <bpmn:incoming>P1_Flow_48</bpmn:incoming>
      <bpmn:incoming>P1_Flow_49</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P1P_T4" name="Comunicar resultado ao restaurante">
      <bpmn:incoming>P1_Flow_50</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_51</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P1P_E1" name="Resultado comunicado">
      <bpmn:incoming>P1_Flow_51</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P1P_TA" name="Avisar restaurante sobre atraso">
      <bpmn:incoming>P1_Flow_52</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_53</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P1P_EA" name="Atraso avisado">
      <bpmn:incoming>P1_Flow_53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P1P_T2" name="Analisar solicitação">
      <bpmn:incoming>P1_Flow_29</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1P_G2" name="Resultado da análise?">
      <bpmn:incoming>P1_Flow_31</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_32</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_33</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1P_TR" name="Registrar motivo da recusa">
      <bpmn:incoming>P1_Flow_34</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_49</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="P1P_BA" name="48 h sem análise" cancelActivity="false" attachedToRef="P1P_T2">
      <bpmn:outgoing>P1_Flow_52</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P1P_BA_ed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P1_Flow_25" sourceRef="P1P_S" targetRef="P1P_T0" />
    <bpmn:sequenceFlow id="P1_Flow_26" sourceRef="P1P_T0" targetRef="P1P_GM" />
    <bpmn:sequenceFlow id="P1_Flow_39" sourceRef="P1P_T7" targetRef="P1P_GM" />
    <bpmn:sequenceFlow id="P1_Flow_27" sourceRef="P1P_GM" targetRef="P1P_T1" />
    <bpmn:sequenceFlow id="P1_Flow_28" sourceRef="P1P_T1" targetRef="P1P_G1" />
    <bpmn:sequenceFlow id="P1_Flow_29" name="sim" sourceRef="P1P_G1" targetRef="P1P_T2" />
    <bpmn:sequenceFlow id="P1_Flow_30" name="não" sourceRef="P1P_G1" targetRef="P1P_GP" />
    <bpmn:sequenceFlow id="P1_Flow_33" name="pendência" sourceRef="P1P_G2" targetRef="P1P_GP" />
    <bpmn:sequenceFlow id="P1_Flow_35" sourceRef="P1P_GP" targetRef="P1P_T6" />
    <bpmn:sequenceFlow id="P1_Flow_36" sourceRef="P1P_T6" targetRef="P1P_GE" />
    <bpmn:sequenceFlow id="P1_Flow_37" sourceRef="P1P_GE" targetRef="P1P_T7" />
    <bpmn:sequenceFlow id="P1_Flow_38" sourceRef="P1P_GE" targetRef="P1P_TM" />
    <bpmn:sequenceFlow id="P1_Flow_40" sourceRef="P1P_TM" targetRef="P1P_GA" />
