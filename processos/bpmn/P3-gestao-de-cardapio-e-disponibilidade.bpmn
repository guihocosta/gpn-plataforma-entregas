<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="P3_Rest" name="Restaurante" processRef="P3_Process_Rest" />
    <bpmn:participant id="P3_Pla" name="Plataforma" processRef="P3_Process_Pla" />
    <bpmn:messageFlow id="P3_Msg_1" name="Alteração do cardápio" sourceRef="P3R_T3" targetRef="P3P_S" />
    <bpmn:messageFlow id="P3_Msg_2" name="Resultado da alteração" sourceRef="P3P_T4" targetRef="P3R_T4" />
    <bpmn:messageFlow id="P3_Msg_3" name="Resultado da alteração" sourceRef="P3P_TN" targetRef="P3R_T4" />
  </bpmn:collaboration>
  <bpmn:process id="P3_Process_Rest" isExecutable="false">
    <bpmn:startEvent id="P3R_S" name="Decide atualizar o cardápio">
      <bpmn:outgoing>P3_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P3R_GL">
      <bpmn:incoming>P3_Flow_1</bpmn:incoming>
      <bpmn:incoming>P3_Flow_13</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P3R_G0" name="O que atualizar?">
      <bpmn:incoming>P3_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3R_T1" name="Editar itens, preços e horário de funcionamento">
      <bpmn:incoming>P3_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P3R_T2" name="Pausar ou reativar item ou restaurante">
      <bpmn:incoming>P3_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3R_GJ">
      <bpmn:incoming>P3_Flow_5</bpmn:incoming>
      <bpmn:incoming>P3_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P3R_T3" name="Enviar alteração do cardápio">
      <bpmn:incoming>P3_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="P3R_T4" name="Receber resultado da alteração">
      <bpmn:incoming>P3_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="P3R_GR" name="Alteração publicada?">
      <bpmn:incoming>P3_Flow_9</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3R_E1" name="Cardápio atualizado">
      <bpmn:incoming>P3_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P3R_GC" name="Corrigir e reenviar?">
      <bpmn:incoming>P3_Flow_11</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3R_E2" name="Alteração descartada">
      <bpmn:incoming>P3_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_Flow_1" sourceRef="P3R_S" targetRef="P3R_GL" />
    <bpmn:sequenceFlow id="P3_Flow_13" name="sim" sourceRef="P3R_GC" targetRef="P3R_GL" />
    <bpmn:sequenceFlow id="P3_Flow_2" sourceRef="P3R_GL" targetRef="P3R_G0" />
    <bpmn:sequenceFlow id="P3_Flow_3" name="itens, preços ou horário" sourceRef="P3R_G0" targetRef="P3R_T1" />
    <bpmn:sequenceFlow id="P3_Flow_4" name="disponibilidade" sourceRef="P3R_G0" targetRef="P3R_T2" />
    <bpmn:sequenceFlow id="P3_Flow_5" sourceRef="P3R_T1" targetRef="P3R_GJ" />
    <bpmn:sequenceFlow id="P3_Flow_6" sourceRef="P3R_T2" targetRef="P3R_GJ" />
    <bpmn:sequenceFlow id="P3_Flow_7" sourceRef="P3R_GJ" targetRef="P3R_T3" />
    <bpmn:sequenceFlow id="P3_Flow_8" sourceRef="P3R_T3" targetRef="P3R_T4" />
    <bpmn:sequenceFlow id="P3_Flow_9" sourceRef="P3R_T4" targetRef="P3R_GR" />
    <bpmn:sequenceFlow id="P3_Flow_10" name="sim" sourceRef="P3R_GR" targetRef="P3R_E1" />
    <bpmn:sequenceFlow id="P3_Flow_11" name="não" sourceRef="P3R_GR" targetRef="P3R_GC" />
    <bpmn:sequenceFlow id="P3_Flow_12" name="não" sourceRef="P3R_GC" targetRef="P3R_E2" />
  </bpmn:process>
  <bpmn:process id="P3_Process_Pla" isExecutable="false">
    <bpmn:startEvent id="P3P_S" name="Alteração recebida">
      <bpmn:outgoing>P3_Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P3P_S_ed" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P3P_T1" name="Conferir restaurante credenciado e ativo">
      <bpmn:incoming>P3_Flow_14</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3P_G1" name="Restaurante ativo?">
      <bpmn:incoming>P3_Flow_15</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P3P_G2" name="Tipo de alteração?">
      <bpmn:incoming>P3_Flow_16</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_18</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3P_T2" name="Validar itens, preços e horário">
      <bpmn:incoming>P3_Flow_18</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3P_G3" name="Dados válidos?">
      <bpmn:incoming>P3_Flow_20</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_21</bpmn:outgoing>
      <bpmn:outgoing>P3_Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P3P_GJ">
      <bpmn:incoming>P3_Flow_19</bpmn:incoming>
      <bpmn:incoming>P3_Flow_21</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3P_T3" name="Aplicar alteração ao cardápio">
      <bpmn:incoming>P3_Flow_23</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P3P_T4" name="Confirmar alteração ao restaurante">
      <bpmn:incoming>P3_Flow_24</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P3P_E1" name="Alteração aplicada">
      <bpmn:incoming>P3_Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P3P_GN">
      <bpmn:incoming>P3_Flow_17</bpmn:incoming>
      <bpmn:incoming>P3_Flow_22</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P3P_TN" name="Informar rejeição ao restaurante">
      <bpmn:incoming>P3_Flow_26</bpmn:incoming>
      <bpmn:outgoing>P3_Flow_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P3P_E2" name="Alteração rejeitada">
      <bpmn:incoming>P3_Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_Flow_14" sourceRef="P3P_S" targetRef="P3P_T1" />
    <bpmn:sequenceFlow id="P3_Flow_15" sourceRef="P3P_T1" targetRef="P3P_G1" />
    <bpmn:sequenceFlow id="P3_Flow_16" name="sim" sourceRef="P3P_G1" targetRef="P3P_G2" />
    <bpmn:sequenceFlow id="P3_Flow_17" name="não" sourceRef="P3P_G1" targetRef="P3P_GN" />
    <bpmn:sequenceFlow id="P3_Flow_18" name="conteúdo" sourceRef="P3P_G2" targetRef="P3P_T2" />
    <bpmn:sequenceFlow id="P3_Flow_19" name="disponibilidade" sourceRef="P3P_G2" targetRef="P3P_GJ" />
    <bpmn:sequenceFlow id="P3_Flow_20" sourceRef="P3P_T2" targetRef="P3P_G3" />
    <bpmn:sequenceFlow id="P3_Flow_21" name="sim" sourceRef="P3P_G3" targetRef="P3P_GJ" />
    <bpmn:sequenceFlow id="P3_Flow_22" name="não" sourceRef="P3P_G3" targetRef="P3P_GN" />
    <bpmn:sequenceFlow id="P3_Flow_23" sourceRef="P3P_GJ" targetRef="P3P_T3" />
    <bpmn:sequenceFlow id="P3_Flow_24" sourceRef="P3P_T3" targetRef="P3P_T4" />
    <bpmn:sequenceFlow id="P3_Flow_25" sourceRef="P3P_T4" targetRef="P3P_E1" />
    <bpmn:sequenceFlow id="P3_Flow_26" sourceRef="P3P_GN" targetRef="P3P_TN" />
    <bpmn:sequenceFlow id="P3_Flow_27" sourceRef="P3P_TN" targetRef="P3P_E2" />
  </bpmn:process>
