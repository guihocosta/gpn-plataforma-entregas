<bpmn:sendTask id="P_T4" name="Comunicar resultado ao entregador"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="P_E1" name="Resultado comunicado"><bpmn:incoming>Flow_30</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="P_GP"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="P_T6" name="Notificar pendência ao entregador"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:sendTask>
