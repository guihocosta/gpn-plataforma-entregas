<bpmn:process id="Process_Ent" isExecutable="false">
<bpmn:startEvent id="E_S" name="Decide trabalhar como entregador"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="E_T1" name="Preencher cadastro, anexar documentos e tirar selfie"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="E_T2" name="Enviar cadastro"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="E_GM"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="E_GE"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:receiveTask id="E_TA" name="Receber aviso de atraso na análise"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:receiveTask>
<bpmn:receiveTask id="E_T4" name="Receber resultado da aprovação"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:receiveTask>
<bpmn:exclusiveGateway id="E_GR" name="Resultado?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_E1" name="Cadastro aprovado"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="E_E2" name="Cadastro recusado ou arquivado"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
<bpmn:receiveTask id="E_T3" name="Receber pendência no cadastro"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:receiveTask>
<bpmn:subProcess id="SPC" name="Corrigir pendência"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:startEvent id="SPC_S"><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="E_T5" name="Corrigir documentos"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:sendTask id="E_T6" name="Reenviar documentos"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="SPC_E"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_13" sourceRef="SPC_S" targetRef="E_T5" /><bpmn:sequenceFlow id="Flow_14" sourceRef="E_T5" targetRef="E_T6" /><bpmn:sequenceFlow id="Flow_15" sourceRef="E_T6" targetRef="SPC_E" /></bpmn:subProcess>
<bpmn:boundaryEvent id="E_BP" name="Prazo da pendência esgotado" attachedToRef="SPC"><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:timerEventDefinition id="E_BP_ed"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">data da pendência + 7 dias</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="E_E3" name="Cadastro arquivado"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
