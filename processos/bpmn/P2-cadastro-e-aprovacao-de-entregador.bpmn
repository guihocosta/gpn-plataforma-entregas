<bpmn:endEvent id="P_EA" name="Atraso avisado"><bpmn:incoming>Flow_39</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="P_T2" name="Analisar cadastro"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="P_BA" name="48 h sem análise" attachedToRef="P_T2" cancelActivity="false"><bpmn:outgoing>Flow_38</bpmn:outgoing><bpmn:timerEventDefinition id="P_BA_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="P_G2" name="Resultado da análise?"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing><bpmn:outgoing>Flow_25</bpmn:outgoing><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="P_TR" name="Registrar motivo da recusa"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:userTask>
