<bpmn:receiveTask id="P_T7" name="Receber documentos corrigidos"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing></bpmn:receiveTask>
<bpmn:intermediateCatchEvent id="P_TM" name="Prazo da pendência esgotado"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing><bpmn:timerEventDefinition id="P_TM_ed"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">data da pendência + 7 dias</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
