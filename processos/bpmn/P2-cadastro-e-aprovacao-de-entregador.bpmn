<bpmn:messageFlow id="Msg_40" name="Cadastro e documentos" sourceRef="E_T2" targetRef="P_S" />
<bpmn:messageFlow id="Msg_41" name="Pendência no cadastro" sourceRef="P_T6" targetRef="E_T3" />
